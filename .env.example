PORT=3000
HOST=0.0.0.0
OFFICIAL_LOOKUP_ENABLED=true
OFFICIAL_LOOKUP_TIMEOUT_MS=3500
OFFICIAL_LOOKUP_CACHE_TTL_SECONDS=3600
PDF_SEARCH_ENABLED=true
PDF_DOCS_DIR=docs/pdfs
PDF_MAX_TEXT_CHARS=200000

# --- Project automation bridge (create/read POUs, DUTs, GVLs directly in .project files) ---
# Path to CODESYS.exe. If unset, the server searches C:\Program Files\CODESYS.
# CODESYS_EXE=C:\Program Files\CODESYS\CODESYS V3.5 SP21\CODESYS.exe
# Installed CODESYS profile name (required for --noUI runs)
CODESYS_PROFILE=CODESYS V3.5 SP21 Patch 1
# Override the bridge folder if bridge.py lives elsewhere
# CODESYS_BRIDGE_DIR=bridge
# Per-call timeout in milliseconds (headless CODESYS start takes ~10-30 s)
CODESYS_BRIDGE_TIMEOUT_MS=240000
